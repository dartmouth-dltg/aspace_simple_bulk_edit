<!-- simple bulk edit -->
<%= stylesheet_link_tag "#{AppConfig[:frontend_proxy_prefix]}assets/aspace_simple_bulk_edit.css?v=#{AppConfig[:aspace_simple_bulk_edit_asset_version]}" %>
<%= javascript_include_tag "#{AppConfig[:frontend_proxy_prefix]}assets/aspace_simple_bulk_edit.js?v=#{AppConfig[:aspace_simple_bulk_edit_asset_version]}" %>

<% if current_repo %>
  <script>
    $(() => {
      const simpleBulkEditActions = new SimpleBulkEdit(`<%= current_repo.uri %>`);
      simpleBulkEditActions.init();
    });
  </script>
<% end %>
